# ============================================================
# MBG Dapur — Environment Variables
# Salin file ini menjadi .env lalu isi nilainya
# ============================================================

# DATABASE — wajib diisi, salah satu dari:
# Opsi A: PostgreSQL lokal
DATABASE_URL=postgresql://postgres:password@localhost:5432/mbg_dapur

# Opsi B: Supabase (jika memakai Supabase, isi ini, DATABASE_URL tidak perlu)
# SUPABASE_DATABASE_URL=postgresql://postgres.xxx:password@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres

# PORT API server (opsional, default: 8080)
# PORT=8080
