{
  "version": 2,
  "buildCommand": "pnpm run build",
  "outputDirectory": "artifacts/mbg-dapur/dist/public",
  "functions": {
    "api/index.mjs": {
      "runtime": "vercel-node@latest"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.mjs"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
